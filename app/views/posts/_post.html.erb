<div class="post">
    <% if post_author?(post) %>
        <%= link_to "Edit post", edit_post_path(post) %>
        <%= button_to "Delete post", post, method: :delete %>
    <% end %>    
    <p><%= display_user(post.post_author) %></p>
    <p><%= post.created_at %></p>
    <p><%= post.content %></p>
    <h3><%= post.comments_count %> Comments</h3>
    <%= render partial: "comments/comment", collection: post.parentless_comments %>
    <div style="margin-top: 25px;">
      <%= form_with url: comments_path do |form| %>
          <%= form.text_field "comment[content]", placeholder: "Comment" %>
          <%= form.hidden_field "post[id]", value: post.id %>
          <%= form.submit "Post" %>
      <% end %>
    </div>
</div>
<hr>