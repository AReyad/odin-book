<div class="post">
    <% if post_author?(post) %>
        <%= link_to "Edit post", edit_post_path(post) %>
        <%= button_to "Delete post", post, method: :delete %>
    <% end %>    
    <p><%= post.post_author.display_name %></p>
    <p><%= post.created_at %></p>
    <p><%= post.content %></p>
    <p><%= post.comments_count %></p>
    <h3>Comments</h3>
    <%= render partial: "comments/comment", collection: post.post_comments %>
</div>
<hr>