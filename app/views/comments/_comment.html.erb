<div class="comment">
    <p><%= display_user(comment.comment_author)%></p>
    <p><%= comment.content %></p>
    <p><%= comment.likes_count %> Likes</p>
    <%= display_like_button(comment, @user_likes) %>
    <div class="reply" style="margin-left: 25px">
    <%= render partial: "comments/reply", collection: comment.replies %>
    <%= form_with url: replies_path do |form| %>
        <%= form.text_field "reply[content]", placeholder: "Reply to #{comment.comment_author.display_name}" %>
        <%= form.hidden_field "comment[id]", value: comment.id %>
        <%= form.submit "Reply" %>
    <% end %>
    </div>
</div>